logs/
tmp/
temp/
/scratch/

# ---- Editor backups ----
*.bak

# ---- Python tooling (only if we add helper scripts) ----
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- Claude Code (local session/config; keep CLAUDE.md tracked) ----
.claude/*
!.claude/agents/
!.claude/commands/
# settings.local.json is per-developer local permissions — never committed.
.claude/settings.local.json
# NOTE: CLAUDE.md is intentionally NOT ignored — it is committed.

# ---- Outbound critique handoffs ----
# chatgpt-cover/ is a scratch bundle for a second opinion on the cover: rendered panels,
# thumbnails and copies of specs, all derived from committed sources by the recipe in its
# own README. Regenerable, several MB of rasters, and not part of the book.
chatgpt-cover/
# cover-suggestions/ is the same kind of thing pointed inward: cover variants built from
# copies of cover_wrap.tex so a change can be looked at before it is ruled on. Rebuildable,
# and nothing in it is authoritative until a variant is applied to cover/ and recorded.
cover-suggestions/
# best-cover/ holds the recommended variant as a ready-to-apply package. It becomes
# authoritative only when it is copied into cover/ and mirrored into record/ -- until
# then it is a proposal, and a proposal committed beside the real cover is a trap.
best-cover/
# FINAL/ is the upload folder assembled for publication day: the three release
# PDFs (~31 MB of build output), the proof rasters, and copies of specs that are
# already tracked elsewhere. PDF_POLICY keeps built PDFs out of the tree until
# the release commit, which force-adds the printed interior alone. This folder
# is a convenience, not a record -- the record is record/.
FINAL/

# ---- Drop-zone ----
# nbj/ — private, never committed.
nbj/

# Reader drafts — not versioned
bbu_reader_draft*.pdf

# Built book PDF — not committed except tagged releases (see process/PDF_POLICY.md)
manuscript/billiard_ball_universe.pdf
