# ---- LaTeX build artifacts ----
# Generated by every compile; regenerable, never committed. The .tex sources
# and the final committed PDF (if you choose to commit it) are the real content.
*.aux
*.lof
*.log
*.lot
*.fls
*.out
*.toc
*.fmt
*.fot
*.cb
*.cb2
.*.lb
*.bbl
*.bcf
*.blg
*-blx.aux
*-blx.bib
*.run.xml
*.fdb_latexmk
*.synctex
*.synctex(busy)
*.synctex.gz
*.synctex.gz(busy)
*.pdfsync
*.idx
*.ilg
*.ind
*.ist
*.glo
*.gls
*.glg
*.acn
*.acr
*.alg
*.nav
*.snm
*.vrb
*.xdv

# Some editors / latexmk drop these:
_minted*/
*.pyg
*.figlist
*.makefile
*.fls

# The compiled book PDF: ignore by default. If you DO want to commit the final
# PDF as a deliverable, remove the next line or force-add it deliberately.
# billiard_ball_universe.pdf
# AI-generated illustration masters live in art/ and ARE committed (they are
# sources, not build artifacts) -- do not add art/ here.

# ---- Environment / secrets ----
# If any tooling talks to an LLM endpoint, keys live here — never commit them.
.env
.env.*
!.env.example
*.local

# ---- Editors / IDEs ----
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.iml
*.swp
*.swo
*~

# ---- OS cruft ----
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
# macOS (in case the repo travels)
.DS_Store
.AppleDouble
# Linux
.directory

# ---- Logs / temp / scratch ----
logs/
tmp/
temp/
/scratch/

# ---- Editor backups ----
*.bak

# ---- Python tooling (only if we add helper scripts) ----
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- Claude Code (local session/config; keep CLAUDE.md tracked) ----
.claude/*
!.claude/agents/
!.claude/commands/
# settings.local.json is per-developer local permissions — never committed.
.claude/settings.local.json
# NOTE: CLAUDE.md is intentionally NOT ignored — it is committed.
